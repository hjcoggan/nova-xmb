+#include <cstring>
+#endif
+
+namespace auroreengine::detail {
+
+#if defined(AUROREENGINE_HAS_WAYLAND) && defined(SDL_VIDEO_DRIVER_WAYLAND)
+namespace {
+
+struct RegistryState {
+    wl_compositor* compositor = nullptr;
+};
+
+void handle_global(void* data, wl_registry* registry, uint32_t name,
+                   const char* interface, uint32_t version) {
+    auto* state = static_cast<RegistryState*>(data);
+    if (std::strcmp(interface, wl_compositor_interface.name) == 0 &&
+        state->compositor == nullptr) {
+        const uint32_t bind_ver = version < 4 ? version : 4;
+        state->compositor = static_cast<wl_compositor*>(
+            wl_registry_bind(registry, name, &wl_compositor_interface, bind_ver));
+    }
+}
+
+void handle_global_remove(void*, wl_registry*, uint32_t) {}
+
+const wl_registry_listener kRegistryListener = {
+    handle_global,
+    handle_global_remove,
+};
+
+wl_compositor* bind_compositor(wl_display* display) {
+    // Use a private proxy wrapper and event queue so binding wl_compositor
+    // never drains SDL2's main Wayland event queue mid-frame.
+    static wl_display* cached_display = nullptr;
+    static wl_compositor* cached_compositor = nullptr;
+    if (cached_display == display && cached_compositor != nullptr) {
+        return cached_compositor;
+    }
+
+    wl_event_queue* queue = wl_display_create_queue(display);
+    if (!queue) {
+        return nullptr;
+    }
+    auto* wrapped = static_cast<wl_display*>(wl_proxy_create_wrapper(display));
+    if (!wrapped) {
+        wl_event_queue_destroy(queue);
+        return nullptr;
+    }
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy*>(wrapped), queue);
+
+    RegistryState state{};
+    if (wl_registry* registry = wl_display_get_registry(wrapped)) {
+        wl_registry_add_listener(registry, &kRegistryListener, &state);
+        wl_display_roundtrip_queue(display, queue);
+        wl_registry_destroy(registry);
+    }
+
+    if (state.compositor) {
+        // Detach the long-lived global from the temporary queue before destroying it.
+        wl_proxy_set_queue(reinterpret_cast<wl_proxy*>(state.compositor), nullptr);
+        cached_display = display;
+        cached_compositor = state.compositor;
+    }
+
+    wl_proxy_wrapper_destroy(wrapped);
+    wl_event_queue_destroy(queue);
+    return state.compositor;
+}
+
+} // namespace
+#endif
+
+void sync_wayland_opaque_region(SDL_Window* window, bool transparent, int width, int height) {
+#if defined(AUROREENGINE_HAS_WAYLAND) && defined(SDL_VIDEO_DRIVER_WAYLAND)
+    if (!window) {
+        return;
+    }
+    SDL_SysWMinfo info{};
+    SDL_VERSION(&info.version);
+    if (!SDL_GetWindowWMInfo(window, &info) || info.subsystem != SDL_SYSWM_WAYLAND) {
+        return;
+    }
+    wl_surface* surface = info.info.wl.surface;
+    wl_display* display = info.info.wl.display;
+    if (!surface) {
+        return;
+    }
+    if (transparent) {
+        // SDL2 installs a full-window opaque wl_region at creation and on every
+        // Wayland configure/resize, causing Sway to skip alpha blending. Clear it
+        // while transparent compositing is active.
+        wl_surface_set_opaque_region(surface, nullptr);
+        return;
+    }
+    if (!display || width <= 0 || height <= 0) {
+        return;
+    }
+    if (wl_compositor* compositor = bind_compositor(display)) {
+        if (wl_region* region = wl_compositor_create_region(compositor)) {
+            wl_region_add(region, 0, 0, width, height);
+            wl_surface_set_opaque_region(surface, region);
+            wl_region_destroy(region);
+        }
+    }
+#else
+    (void)window;
+    (void)transparent;
+    (void)width;
+    (void)height;
+#endif
+}
+
+bool wait_fd_readable(int fd, int timeout_ms) {
+#if defined(__unix__) || defined(__APPLE__)
+    if (fd < 0) {
+        return false;
+    }
+    pollfd pfd{fd, POLLIN, 0};
+    const int ready = poll(&pfd, 1, timeout_ms);
+    return ready > 0 && (pfd.revents & POLLIN) != 0;
+#else
+    (void)fd;
+    (void)timeout_ms;
+    return false;
+#endif
+}
+
+} // namespace auroreengine::detail
