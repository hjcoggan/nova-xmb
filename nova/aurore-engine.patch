+
+// Liquid Glass panel. Colour is linear; output is premultiplied.
+// The contrast cap (0.10) matches openxmb::xmb::glass::max_body_luminance:
+// white text over the body holds 7:1.
+// Continuous (squircle) corners: a superellipse of exponent 4 in the corner
+// region, so curvature flows from the straight edge into the arc instead of
+// jumping the way a circular rounded box does.
+float roundedBox(vec2 p, vec2 halfSize, float radius) {
+    vec2 q = abs(p) - (halfSize - vec2(radius));
+    vec2 k = max(q, vec2(0.0));
+    float d = pow(pow(k.x, 4.0) + pow(k.y, 4.0), 0.25) - radius;
+    return d + min(max(q.x, q.y), 0.0);
+}
+vec4 panel() {
+    vec2 size = max(pc.shape.xy, vec2(1.0));
+    float radius = clamp(pc.shape.z, 0.0, 0.5 * min(size.x, size.y));
+    float flags = pc.shape.w;
+    bool hasBackdrop = mod(flags, 2.0) >= 1.0;
+    bool samples = flags >= 2.0;
+    vec2 p = vUV * size - 0.5 * size;
+    float dist = roundedBox(p, 0.5 * size, radius);
+    float inside = -dist;
+    float coverage = clamp(inside + 0.5, 0.0, 1.0);
+    if(coverage <= 0.0) return vec4(0.0);
+    // Inward normal from the distance gradient.
+    const float e = 0.5;
+    vec2 grad = vec2(roundedBox(p + vec2(e, 0.0), 0.5 * size, radius) - roundedBox(p - vec2(e, 0.0), 0.5 * size, radius),
+                     roundedBox(p + vec2(0.0, e), 0.5 * size, radius) - roundedBox(p - vec2(0.0, e), 0.5 * size, radius));
+    vec2 outward = length(grad) > 1e-5 ? normalize(grad) : vec2(0.0, -1.0);
+    vec2 inward = -outward;
+    // Rim: thin and brightest where the edge faces a light from the upper left.
+    float edge = 1.0 - smoothstep(0.0, 1.5, inside);
+    float light = 0.5 + 0.5 * dot(outward, normalize(vec2(-0.6, -0.8)));
+    float rim = edge * (0.25 + 0.55 * light);
+    float sheen = 0.025 * (1.0 - smoothstep(0.0, 0.45, vUV.y));
+    float alpha = pc.color.a * coverage;
+    if(!samples) {
+        // Focus: light added inside a card, no body of its own.
+        vec3 lift = vec3(pc.material.z) + vec3(sheen * 0.5);
+        vec3 light_rgb = lift + pc.color.rgb * rim;
+        float a = clamp(max(pc.material.z, rim), 0.0, 1.0);
+        return vec4(light_rgb * alpha, a * alpha);
+    }
+    vec3 body;
+    if(hasBackdrop) {
+        vec2 screenSize = vec2(textureSize(uBackdrop, 0));
+        vec2 uv = gl_FragCoord.xy / screenSize;
+        float band = max(1.0, min(radius, 0.5 * min(size.x, size.y)));
+        float bend = pow(1.0 - clamp(inside / band, 0.0, 1.0), 2.0);
+        vec2 offset = inward * pc.material.x * bend / screenSize;
+        float lod = pc.material.y;
+        // A 3x3 tent over trilinear mips: smooth, no blocks from the box-
+        // filtered chain.
+        vec2 texel = exp2(lod) / screenSize;
+        vec3 c = vec3(0.0);
+        for(int y = -1; y <= 1; ++y)
+            for(int x = -1; x <= 1; ++x) {
+                float w = (2.0 - abs(float(x))) * (2.0 - abs(float(y)));
+                c += w * textureLod(uBackdrop, uv + offset + vec2(float(x), float(y)) * texel, lod).rgb;
+            }
+        c /= 16.0;
+        float grey = dot(c, vec3(0.2126, 0.7152, 0.0722));
+        c = max(mix(vec3(grey), c, 1.25), vec3(0.0)) * 1.08 + vec3(0.004);
+        float lum = dot(c, vec3(0.2126, 0.7152, 0.0722));
+        float tint = pc.material.z;
+        float dim = clamp(1.0 - (0.10 - tint - sheen) / max(lum, 1e-4), 0.0, 1.0) * pc.material.w;
+        body = c * (1.0 - dim) + vec3(tint);
+    } else {
+        // No backdrop: an opaque body dark enough for the same contrast.
+        body = srgb_to_linear(vec3(28.0, 32.0, 44.0) / 255.0);
+    }
+    body += vec3(sheen) + pc.color.rgb * rim;
+    float bodyAlpha = hasBackdrop ? 1.0 : 0.92;
+    return vec4(body * alpha * bodyAlpha, alpha * bodyAlpha);
+}
+
 void main() {
-    FragColor = pc.index==1u?frame():glassIcon(vUV);
+    FragColor = pc.index==2u?panel():pc.index==1u?frame():glassIcon(vUV);
 }
